# CLIENT ONLY. One LiteLLM Virtual Key per installation; never the host master key.
LITELLM_BASE_URL=http://192.168.1.77:4000/v1
LITELLM_API_KEY=replace-with-client-virtual-key
AGENT_MODEL=local-agent-coder
# Separate local API token: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_LOCAL_TOKEN=replace-with-random-token-at-least-32-characters
AGENT_PORT=8765
# Default data directory is this project directory, preserving legacy data.
# AGENT_DATA_DIR=C:/Users/yourname/AppData/Local/LocalAgent
